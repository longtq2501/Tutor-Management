# ==========================================
# ENV TEMPLATE FOR VPS DEPLOYMENT 
# COPY THIS FILE TO .env ON YOUR VPS AND FILL IN THE VALUES
# ==========================================

# 1. DOCKER HUB
DOCKERHUB_USERNAME=your_dockerhub_username

# 2. DATABASE CONFIGURATION
MYSQL_DATABASE=tutor_management_db
MYSQL_ROOT_PASSWORD=your_highly_secure_root_password
MYSQL_USERNAME=tutor_user
MYSQL_PASSWORD=your_highly_secure_password

# 3. BACKEND SECURITY (SPRING BOOT)
# Dùng để ký JWT Token. Có thể sinh ra bằng lệnh: openssl rand -base64 64
JWT_SECRET=your_super_secret_jwt_signing_key_here

# 4. GOOGLE OAUTH2 (Từ Google Cloud Console)
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret

# 5. FRONTEND CONFIGURATION (NEXT.JS)
# URL API Backend cho Frontend. 
# QUAN TRỌNG: Trên môi trường Production, đây là URL Public của domain.
# Ví dụ: https://api.yourdomain.com
NEXT_PUBLIC_API_URL=http://your_vps_ip_or_domain:8080

# 5.1 BACKEND PUBLIC URL (Dùng cho OAuth callback redirect trong backend)
# Ví dụ: https://api.yourdomain.com
BACKEND_URL=http://your_vps_ip_or_domain:8080

# QUAN TRỌNG CHO GOOGLE OAUTH:
# Trong Google Cloud Console -> OAuth Client -> Authorized redirect URIs,
# PHẢI có URI callback tương ứng với BACKEND_URL + /login/oauth2/code/google.

# 6. JAVA OPTIONS (Tuỳ chọn cấu hình tối đa mức RAM cho VPS 4GB)
# Giới hạn Heap (Dữ liệu tạm của Java): Khởi điểm 256MB, Tối đa 768MB.
# Bật bộ thu gom rác G1GC hiện đại (chuyên dùng cho web app nhiều luồng/VPS nhiều CPU)
JAVA_OPTS="-Xms256m -Xmx768m -XX:+UseG1GC -XX:MaxMetaspaceSize=256m"
